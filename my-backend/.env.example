# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Please add `import "dotenv/config";` to your `prisma7.config.ts` file, or use the Prisma CLI with Bun
# to load environment variables from .env files: https://pris.ly/prisma-config-env-vars.

# Prisma supports the native connection string format for PostgreSQL, MySQL, SQLite, SQL Server, MongoDB and CockroachDB.
# See the documentation for all the connection string options: https://pris.ly/d/connection-strings

DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres
PORT=5000

# --- Auth (dummy: replace before production) ---
JWT_ACCESS_SECRET=dummy_access_secret_change_me_min_32_chars_long
JWT_REFRESH_SECRET=dummy_refresh_secret_change_me_min_32_chars_long
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# --- AWS S3 (dummy values) ---
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=dummy_aws_access_key_id
AWS_SECRET_ACCESS_KEY=dummy_aws_secret_access_key
S3_BUCKET=snk-wedding-dummy-bucket

# --- bKash tokenized checkout (dummy sandbox values) ---
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=dummy_bkash_app_key
BKASH_APP_SECRET=dummy_bkash_app_secret
BKASH_USERNAME=dummy_bkash_username
BKASH_PASSWORD=dummy_bkash_password
BKASH_CALLBACK_URL=http://localhost:5000/api/payments/bkash/callback
# --- App ---
CORS_ORIGIN=http://localhost:3000

# --- First admin created by `npm run seed:admin` (dummy: change) ---
ADMIN_EMAIL=admin@snk.local
ADMIN_PASSWORD=ChangeMe12345
ADMIN_NAME=SNK Admin

# --- Payments ---
# mock = fake bKash for local testing (no real calls). live = real bKash API.
BKASH_MODE=mock
FRONTEND_URL=http://localhost:3000

# --- Storage & background jobs ---
# mock = files saved on local disk (.storage/), no AWS needed. live = real S3 bucket.
STORAGE_MODE=mock
API_BASE_URL=http://localhost:5000
JOBS_ENABLED=true

# Number of reverse proxies in front of the API (0 = none). Set to 1 behind a single proxy/load balancer.
TRUST_PROXY=0
# --- SMS (phone verification codes) ---
# mock = codes are printed in the server console (and returned by the API outside production).
SMS_MODE=mock
SMS_API_URL=https://sms-gateway.invalid/send
SMS_API_KEY=dummy_sms_api_key
SMS_SENDER_ID=SnapNKeep

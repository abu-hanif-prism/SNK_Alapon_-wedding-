enum UploadBatchStatus {
  RESERVED
  COMPLETED
  EXPIRED
  CANCELED
}

enum ProcessingStatus {
  PENDING
  PROCESSING
  READY
  FAILED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PhotoVariantKind {
  WEB
  THUMBNAIL
}

// One guest upload session. Reserves quota (photos and bytes) until completed or expired.
model UploadBatch {
  id                 String            @id @default(uuid()) @db.Uuid
  eventId            String            @db.Uuid
  guestId            String            @db.Uuid
  uploadLinkId       String            @db.Uuid
  idempotencyKey     String
  message            String?
  status             UploadBatchStatus @default(RESERVED)
  reservedPhotoCount Int
  reservedBytes      BigInt
  expiresAt          DateTime          @db.Timestamptz(3)
  createdAt          DateTime          @default(now()) @db.Timestamptz(3)
  completedAt        DateTime?         @db.Timestamptz(3)

  event      Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest      Guest      @relation(fields: [guestId], references: [id], onDelete: Cascade)
  uploadLink UploadLink @relation(fields: [uploadLinkId], references: [id], onDelete: Restrict)
  photos     Photo[]

  @@unique([guestId, idempotencyKey])
  @@index([eventId])
  @@index([status, expiresAt])
  @@map("upload_batches")
}

// Exactly one of uploadBatchId (guest) / uploadedByHostId (host) is set.
// Enforced by a CHECK constraint added in the migration.
model Photo {
  id                  String           @id @default(uuid()) @db.Uuid
  eventId             String           @db.Uuid
  uploadBatchId       String?          @db.Uuid
  uploadedByHostId    String?          @db.Uuid
  originalObjectKey   String           @unique
  originalFilename    String
  mimeType            String
  byteSize            BigInt
  width               Int?
  height              Int?
  processingStatus    ProcessingStatus @default(PENDING)
  // Background worker bookkeeping: retries and recovery of jobs that died mid-way.
  processingAttempts  Int              @default(0)
  processingStartedAt DateTime?        @db.Timestamptz(3)
  processingError     String?
  approvalStatus      ApprovalStatus   @default(PENDING)
  caption             String?
  // Optional note a guest attached to this specific photo.
  guestNote           String?
  capturedAt          DateTime?        @db.Timestamptz(3)
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)
  deletedAt           DateTime?        @db.Timestamptz(3)

  event          Event            @relation("EventPhotos", fields: [eventId], references: [id], onDelete: Cascade)
  uploadBatch    UploadBatch?     @relation(fields: [uploadBatchId], references: [id], onDelete: Restrict)
  uploadedByHost User?            @relation(fields: [uploadedByHostId], references: [id], onDelete: Restrict)
  variants       PhotoVariant[]
  placements     PhotoPlacement[]
  moderationLogs ModerationLog[]
  coverOfEvents  Event[]          @relation("EventCoverPhoto")

  @@index([eventId, approvalStatus, deletedAt])
  @@index([uploadBatchId])
  @@index([processingStatus, createdAt])
  @@map("photos")
}

model PhotoVariant {
  id        String           @id @default(uuid()) @db.Uuid
  photoId   String           @db.Uuid
  kind      PhotoVariantKind
  objectKey String           @unique
  width     Int
  height    Int
  byteSize  BigInt
  mimeType  String

  photo Photo @relation(fields: [photoId], references: [id], onDelete: Cascade)

  @@unique([photoId, kind])
  @@map("photo_variants")
}
